{
  "id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
  "name": "LendLoop — Daily Overdue Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      },
      "id": "cron-trigger",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3211/api/overdue",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-overdue",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "VpXcpW2KowjgLbIo",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-items",
      "name": "Split into items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@lendloop.local",
        "toEmail": "={{ $json.borrowerEmail }}",
        "subject": "LendLoop — Your borrowed tool is overdue",
        "text": "Hi {{ $json.borrowerName }},\n\nThis is a reminder that '{{ $json.toolName }}' was due back on {{ $json.endDate }} and is now overdue. Please return it to the owner as soon as possible.\n\nLendLoop"
      },
      "id": "send-reminder",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [900, 300],
      "credentials": {
        "smtp": {
          "id": "lendloop-smtp",
          "name": "LendLoop SMTP"
        }
      }
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3211/api/reminder",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "loanId", "value": "={{ $json.loanId }}" }
          ]
        },
        "options": {}
      },
      "id": "mark-reminder-sent",
      "name": "Mark reminderSentAt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "VpXcpW2KowjgLbIo",
          "name": "Header Auth account"
        }
      }
    }
  ],
  "connections": {
    "Daily 08:00": {
      "main": [[{ "node": "Fetch overdue loans", "type": "main", "index": 0 }]]
    },
    "Fetch overdue loans": {
      "main": [[{ "node": "Split into items", "type": "main", "index": 0 }]]
    },
    "Split into items": {
      "main": [[{ "node": "Send reminder", "type": "main", "index": 0 }]]
    },
    "Send reminder": {
      "main": [[{ "node": "Mark reminderSentAt", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {}
}
